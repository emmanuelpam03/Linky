# Runtime Neon URL; use the pooled endpoint for serverless deployments.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DBNAME?sslmode=require"

# Prisma CLI migration URL from the same Neon project, branch, database, and role.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require"

# Better Auth base URL for local development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WebSocket server used by the local chat UI.
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
WS_PORT=3001

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret"

# Gmail SMTP (use a Google App Password, not your Gmail password).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-16-character-google-app-password"
SMTP_FROM="your-gmail-address@gmail.com"

# ImageKit upload credentials.
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
